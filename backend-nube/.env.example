# Variables de entorno del backend (Vercel + Supabase)
# Copiar a `.env` para desarrollo local, y configurarlas en
# Vercel → Project → Settings → Environment Variables para producción.

# Supabase → Settings → API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase → Settings → API → service_role key (¡SECRETA! solo en el servidor)
SUPABASE_SERVICE_KEY=eyJ...

# Token que usa el concentrador para autenticarse contra esta API.
# Generar uno largo y aleatorio. El mismo valor va en concentrador/config.yaml
CONCENTRADOR_TOKEN=cambiar-por-un-token-largo-y-aleatorio
